{
  "expo": {
    "name": "Radio Studio Sat",
    "slug": "radio-studio-sat",
    "owner": "techprosolutions-inc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "studiosat",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.studiosatweb.radio",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "br.com.studiosatweb.radio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F8FC"
      },
      "permissions": [
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F8FC"
        }
      ]
    ],
    "extra": {
      "studiosat": {
        "portalUrl": "https://www.radio.studiosatweb.com.br",
        "playerUrl": "https://radio.studiosatweb.com.br",
        "contentApiUrl": "https://www.radio.studiosatweb.com.br/api/content"
      },
      "eas": {
        "projectId": "54defc13-e1ad-4bea-91f3-283d508560fb"
      }
    }
  }
}
